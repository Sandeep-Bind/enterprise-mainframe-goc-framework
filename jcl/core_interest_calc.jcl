//CBINT01P JOB (ACCT#),'DAILY INTEREST BATCH',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//*------------------------------------------------------------------*
//* MODULE: CBINT01P                                                 *
//* DESC  : CALCULATES AND POSTS ACCRUED INTEREST FOR ACTIVE ACCOUNTS*
//* SCHED : CONTROL-M DEPENDENCY STREAM [DEP_PREV_ACCOUNT_UPDATE]    *
//*------------------------------------------------------------------*
//JOBLIB   DD DSN=PROD.APPL.LOADLIB,DISP=SHR
//         DD DSN=SYS1.DB2.RUNLIB.LOAD,DISP=SHR
//STEP01   EXEC PGM=IKJEFT01,DYNAMNBR=50
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CBINTPGM) PLAN(CBPLAN01)
/*
//SYSIN    DD *
  UPDATE CORE_ACCOUNTS 
     SET INTEREST_ACCRUED = BALANCE * 0.0485,
         LAST_UPDATED = CURRENT TIMESTAMP
   WHERE STATUS = 'ACTIVE'
     AND BALANCE > 0.00;
/*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*